# 系统与工具产物
*.log
*.tmp
*.bak
*.swp
.DS_Store
Thumbs.db

# 构建与依赖目录
node_modules/
dist/
build/
out/
target/
.cache/
venv/
.venv/
__pycache__/
.mimosa/
**/.mimosa/

# 本机智能体工作数据（日志、记忆），与仓库内容无关
/.workbuddy/
# TRAE HTML 分享功能生成的本地分享包
/.trae-html-share-packages/

# 裁判台自检失败时写下的环境/命令证据（本机诊断用）
/自检诊断.txt

# 编辑器与 IDE
.vscode/
.idea/
*.iml

# 本地环境与密钥
.env
.env.*
*.local

# 开发/历史资料区：默认整片忽略（MVP 预言机、第三方参照模板、50 轮历史测试包，
# 合计几百 MB，都是本地资料）。只有下面白名单里的设计文档入库。
# 写法讲究：先 /Dev/* 全忽略，再逐个放行直接子项。git 不会进入被忽略的目录内部，
# 所以放行必须写在第一层，不能指望在更深层写 ! 把文件捞回来。
/Dev/*
!/Dev/Docs/
!/Dev/ORACLE.md
!/Dev/Plan_Beta.md
!/Dev/README.md
!/Dev/plan.md
!/Dev/experiments/
!/Dev/reviews/
!/Dev/archive/

# 正式赛构建产物与可重建回放（源码、赛程、结果、成绩仍入库）
/war_of_desert/bots/bin/
/war_of_desert/results/*/replays/
/war_of_desert/experiment-records/*/*/replays/

# 每次 build / 初始化都会重写的本地产物，不入库：
# - bots/seal-records/<赛季>.json 的 binSha256 每次编译都变，源码哈希不变；
#   一季一本，build 只写自己那本。赛季实际跑过的那一份归档在
#   results/<赛季>/封存记录.json，审计口径见 war_of_desert/results/README.md。
# - algorithm-contest/赛程.json 由 `--init` 按当前报名者重新生成。
/war_of_desert/bots/封存记录.json
/war_of_desert/bots/seal-records/
/algorithm-contest/赛程.json

# 裁判台工作区评测：暂存副本与临时产物不入库
/war_of_desert/workspace/_contestants/
/war_of_desert/results/desk/
/war_of_desert/tournament/_desk_*.json

# 裁判台比赛/测试成绩：本地生成的对局记录与回放，不入库
/algorithm-contest/match-records/
/algorithm-contest/tests/test-results/
/algorithm-contest/tests/referee-desk-evals/
/algorithm-contest/tests/contestant-local-matches/
/algorithm-contest/tests/history-full-workflow/
# 历史赛季目录保留赛程/结果/成绩；回放可由 arena run 重建，不入库
/algorithm-contest/tests/history-seasons/*/replays/

# 实验标定临时产物：座位/公平性诊断用的短跑目录，结论已归档到正式实验目录
/war_of_desert/results/_tmp-*/
/war_of_desert/tournament/_tmp_*.json

# 裁判台演示工作区（本地测试用）
/_demo工作区/

# 选手工作区：发卷产物、赛务记录与收卷副本都是本地生成的，不入库
/algorithm-contest/rts-contest@*/workspace/
/algorithm-contest/rts-contest@*/submissions/
/algorithm-contest/rts-contest@*/.赛务.json

# 被 _ 前缀隔离的历史选手目录（赛程.json 的 note 里解释了这种隔离方式）
# 名字不再以 rts-contest 开头，上面的规则匹配不到，必须单列——否则 18MB 的 arena 副本
# 会以未跟踪状态挂在 git status 里，一个 git add -A 就进库了。
/algorithm-contest/_rts-contest@*/workspace/
/algorithm-contest/_rts-contest@*/submissions/
/algorithm-contest/_rts-contest@*/.赛务.json

# 模板工作区是选手包的唯一真源，必须入库（上面的忽略规则要放行它）
!/algorithm-contest/rts-contest@model-name/workspace/
!/algorithm-contest/rts-contest@model-name/workspace/**

# 选手包里的 arena/ 由赛务.py 从引擎源码同步（--sync-engine），不重复入库
/algorithm-contest/rts-contest@model-name/workspace/arena/
/algorithm-contest/rts-contest@model-name/workspace/match-records/
/algorithm-contest/rts-contest@model-name/workspace/bot.exe

# 上面的 !...workspace/** 是白名单，会盖住文件开头的 __pycache__/ 规则。
# 这里必须再写一遍，否则跑一次 clock.py 就在模板里留下 .pyc 并跟着发卷出去。
/algorithm-contest/rts-contest@model-name/workspace/**/__pycache__/
/algorithm-contest/rts-contest@model-name/workspace/**/*.pyc

# 引擎宿主构建产物（arena 与选区自检都会用到）
/war_of_desert/.bin/

# 本地对局产物
/algorithm-contest/rts-contest@model-name/workspace/matches/

# 正式赛 beta 发布包：解包目录与 7z 压缩包都是本地构建产物，不入库
/_发布包/
# 若重新解包/打包到仓库根目录，同样忽略
/Meow社区比赛__WoD正式赛_beta*

# 历史全流程测试存档已迁到 algorithm-contest/tests/history-full-workflow/（见上方忽略规则）

# 基线调试与测试轮的本地结果（证据归档在 experiment-records/bot-experiments/）
/war_of_desert/results/baseline-*/
/war_of_desert/results/test-*/
/war_of_desert/experiment-records/reference-bots-archive/bin/
/war_of_desert/experiment-records/offense-defense-experiments/bin/

# v1.9.2 714 局全链路回归留档：成绩/赛程/结果入库，回放仍由上面的 replays 规则忽略
!/war_of_desert/results/test-v192-full/

