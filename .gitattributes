# 规则快照按“字节”管理，禁止任何 EOL 转换。
# 原因：engine/oracle/MANIFEST.json 记录的是文件内容的 SHA-256。
# 在 core.autocrlf=true 的 Windows 上，checkout 会把 LF 转成 CRLF，
# 字节数变化（每条换行 +1），哈希随之失配，第 1 季的复现性就是假的。
# 用 `python -X utf8 war_of_desert/scripts/verify_oracle.py` 校验。
war_of_desert/engine/oracle/* -text

# 回放、赛程、成绩等产物按字节留档，同样不做 EOL 转换。
war_of_desert/results/** -text

# 封存记录（bots/封存记录.json）按字节比对选手源码的 SHA-256。
# 统一 LF：否则本机工作区（CRLF）与干净克隆（LF）算出来的哈希不同，
# `arena seal` 在别人的机器上永远报红。实测过：clone 后 6/6 全失配。
war_of_desert/workspace/** text eol=lf

# golden trace 是逐帧哈希基准，按字节留档。
war_of_desert/engine/golden/* -text

# 批处理脚本必须 CRLF：cmd 逐行解析 .bat，换行风格不对会出怪问题。
*.bat text eol=crlf
